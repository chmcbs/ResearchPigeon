# Copy to .env for local development. On the server, create .env with production values only.

# --- Application ---
APP_ENV=development
APP_BASE_URL=http://localhost:8000
PRODUCT_NAME=ResearchPigeon
SOCIAL_X_URL=https://x.com/researchpigeon_
SOCIAL_BLUESKY_URL=https://bsky.app/profile/researchpigeon.com

# --- Database (local docker-compose exposes 5433) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/researchpigeon

# --- Auth (development only — returns magic link in API response) ---
# In production (APP_ENV=production): must be unset or 0.
# Prod compose pins this to 0 on both api and worker so a copied local .env cannot leak it.
ALLOW_DEV_MAGIC_LINK_RESPONSE=1

# --- Email (required in production; local compose defaults to Mailpit) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=noreply@localhost
# Mailpit web UI: http://localhost:8025
# SMTP_USE_STARTTLS=0
# Production example:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_SSL=1

# --- Debug (optional; keep off in production) ---
# Production (APP_ENV=production) rejects ALLOW_DEBUG_FEATURES=1 and the
# ALLOW_DEBUG_DIGEST_DATA_RESET fallback. Prod compose also pins them to 0.
DEBUG_ADMIN_EMAILS=
ALLOW_DEBUG_FEATURES=0
# ALLOW_DEBUG_DIGEST_DATA_RESET=0

# --- Reverse proxy (set 1 when behind Caddy/nginx you control) ---
# X-Forwarded-For is used only when the connecting IP is in TRUSTED_PROXY_IPS.
# Have the proxy overwrite X-Forwarded-For to the real client address.
TRUST_PROXY_HEADERS=0
# TRUSTED_PROXY_IPS=127.0.0.1,::1

# --- Pipeline tuning ---
# Comma-separated category IDs offered in the profile picker (labels in data/arxiv_category_labels.json).
# Ingestion only fetches categories used by digest-enabled profiles, not this whole list.
# INGESTION_MAX_RESULTS and EMBEDDING_LIMIT apply to the worker (daily cron)
# and the API (debug test-generation). Prod compose pins the same defaults on both.
ARXIV_CATEGORIES=cs.AI,cs.CL,cs.CV,cs.LG,cs.NE,cs.IR,cs.CR,cs.RO,cs.MA,cs.SI,cs.HC,cs.DB,cs.DS,cs.IT,cs.SE,cs.PL
INGESTION_MAX_RESULTS=150
EMBEDDING_LIMIT=600
DAILY_PICKS_K=3
KEYWORD_BOOST_CAP=0.25

# --- Feedback tuning ---
FEEDBACK_ALPHA_FLOOR=0.20
FEEDBACK_DISLIKE_WEIGHT=0.50

# --- Rate limits (database-backed when APP_ENV=production) ---
RATE_LIMIT_WINDOW_SECONDS=3600
TEST_GENERATION_LIMIT_PER_USER=5
MAGIC_LINK_REQUEST_LIMIT_PER_EMAIL=3
MAGIC_LINK_REQUEST_LIMIT_PER_IP=20
MAGIC_LINK_VERIFY_LIMIT_PER_IP=30
# RATE_LIMIT_USE_DATABASE=1

# --- Worker (docker-compose) ---
# Daily digest starts at 04:00 Europe/London and sends at 06:00.
# CRON_INTERVAL_SECONDS is unused; the worker waits on that UK clock.
MONITOR_STATE_PATH=/tmp/researchpigeon-monitor-state.json
MONITOR_ALERT_COOLDOWN_S=3600
MONITOR_CRON_RUNTIME_WARNING_S=300
MONITOR_ZERO_OUTPUT_STREAK_THRESHOLD=2
MONITOR_DAILY_SUMMARY_ENABLED=1
# Optional: include your log location in alert bodies
# LOG_PATH=/var/log/researchpigeon/worker.log

# --- LLM blurbs ---
# Docker Compose (local and prod) always sets LLM_PROVIDER=openai.
# Pytest still uses mock. Raw `uvicorn` without this file defaults to mock.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-nano
LLM_BATCH_CONCURRENCY=1
LLM_BATCH_TIMEOUT_S=600
LLM_BATCH_MAX_TOKENS=50000
LLM_REQUEST_TIMEOUT_S=120
# Stamp stored with each blurb. Code default is 2 (current prompt). Bump this to
# label a new prompt; existing descriptions are not regenerated automatically.
LLM_PROMPT_VERSION=2
LLM_ABSTRACT_MAX_CHARS=1500
LLM_FAILURE_ALERT_THRESHOLD=0.10

# --- Production-only (docker-compose.prod.yml) ---
# Do not copy SMTP_HOST=mailpit onto the VPS — use a real mail provider.
# Overlay leftovers (Mailpit still starts; API 8000 published) are listed at
# the top of docker-compose.prod.yml. Change those when the box exists.
# POSTGRES_PASSWORD=change-me
# APP_BASE_URL=https://your-domain.com
# EMAIL_UNSUBSCRIBE_SECRET=

# --- OpenAI batch-size examples ---
# Conservative
# LLM_BATCH_CONCURRENCY=1
# LLM_BATCH_MAX_TOKENS=25000
#
# Default (matches values above)
# LLM_BATCH_MAX_TOKENS=50000
#
# Optional ramp
# LLM_BATCH_CONCURRENCY=2
# LLM_BATCH_MAX_TOKENS=75000

# --- Do not set in production ---
# DISABLE_CSRF=1
# DISABLE_RATE_LIMIT=1

